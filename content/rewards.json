        {
          "stat": "bestCombo",
          "maxField": "combo"
        },
        {
          "stat": "tryAgains",
          "add": 1,
          "when": {
            "mistakes": {
              "gte": 1
            }
          }
        },
        {
          "stat": "replays",
          "add": 1,
          "when": {
            "firstClear": false
          }
        }
