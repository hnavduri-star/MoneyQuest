  "nodes": [
    {
      "id": "revenue",
      "kind": "lesson",
      "icon": "🍋",
      "title": {
        "en": "Your first business",
        "ar": "مشروعك الأول"
      },
      "steps": [
        {
          "type": "story",
          "art": "stand",
          "mascot": "excited",
          "text": {
            "en": "Welcome to {stop} in {city}! It's a sunny day, and people want cold mint lemonade. You decide to open a stand. A BUSINESS sells PRODUCTS (things) or SERVICES (help) that people want and will pay for.",
            "ar": "أهلاً بك في {stop} في {city}! يوم مشمس والناس يريدون ليمونادة بالنعناع باردة. قررت أن تفتح كشكاً. المشروع التجاري يبيع منتجات (أشياء) أو خدمات (مساعدة) يريدها الناس ويدفعون ثمنها."
          }
        },
        {
          "type": "story",
          "art": "profit",
          "mascot": "happy",
          "text": {
            "en": "Every cup you sell brings money in. All the money from sales is called REVENUE (or sales).",
            "ar": "كل كوب تبيعه يُدخل مالاً. كل مال المبيعات يسمى الإيرادات (أو المبيعات)."
          }
        },
        {
          "type": "number",
          "concept": "revenue",
          "prompt": {
            "7-9": {
              "en": "You sell 5 cups at [[2]] each. What's your revenue?",
              "ar": "بعت ٥ أكواب بسعر [[2]] للكوب. ما إيراداتك؟"
            },
            "default": {
              "en": "You sell 40 cups at [[5]] each. What is your revenue?",
              "ar": "بعت ٤٠ كوباً بسعر [[5]] للكوب. ما إيراداتك؟"
            }
          },
          "answer": {
            "7-9": 10,
            "default": 200
          },
          "explain": {
            "en": "Revenue = price × number sold.",
            "ar": "الإيرادات = السعر × عدد المبيعات."
          },
          "money": true,
          "hint": {
            "7-9": {
              "en": "5 × 2",
              "ar": "٥ × ٢"
            },
            "default": {
              "en": "40 × 5",
              "ar": "٤٠ × ٥"
            }
          }
        },
        {
          "type": "choice",
          "concept": "revenue",
          "prompt": {
            "en": "Which is a SERVICE business?",
            "ar": "أيّها مشروع خدمات؟"
          },
          "options": [
            {
              "text": {
                "en": "Washing cars",
                "ar": "غسل السيارات"
              },
              "correct": true,
              "emoji": "🚗"
            },
            {
              "text": {
                "en": "Selling lemonade",
                "ar": "بيع الليمونادة"
              },
              "emoji": "🍋"
            },
            {
              "text": {
                "en": "Selling toys",
                "ar": "بيع الألعاب"
              },
              "emoji": "🧸"
            }
