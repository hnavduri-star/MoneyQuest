      "steps": [
        {
          "type": "story",
          "art": "ingredients",
          "mascot": "thinking",
          "text": {
            "en": "Running a stand costs money too. Lemons, mint, sugar, ice and cups are needed for EVERY cup: VARIABLE costs. The stall rent costs the same however many cups you sell: a FIXED cost.",
            "ar": "تشغيل الكشك يكلف مالاً أيضاً. الليمون والنعناع والسكر والثلج والأكواب لازمة لكل كوب: تكاليف متغيرة. أما إيجار الكشك فثابت مهما بعت: تكلفة ثابتة."
          }
        },
        {
          "type": "sort",
          "concept": "costs",
          "prompt": {
            "en": "Sort the stand's costs.",
            "ar": "صنّف تكاليف الكشك."
          },
          "bins": [
            {
              "id": "var",
              "emoji": "🥤",
              "label": {
