          }
        },
        {
          "type": "number",
          "concept": "costs",
          "prompt": {
            "en": "Each cup costs [[2]] to make. You make 30 cups. What do the ingredients cost?",
            "ar": "كل كوب يكلف [[2]]. صنعت ٣٠ كوباً. كم تكلف المكونات؟"
          },
          "answer": 60,
          "explain": {
            "en": "Cost per cup × cups = variable cost: 2 × 30 = 60.",
            "ar": "تكلفة الكوب × الأكواب = التكلفة المتغيرة: ٢ × ٣٠ = ٦٠."
          },
          "money": true
        },
        {
          "type": "choice",
          "concept": "costs",
          "prompt": {
            "en": "If you sell MORE cups, what happens to the stall rent?",
            "ar": "إذا بعت أكواباً أكثر، ماذا يحدث لإيجار الكشك؟"
          },
          "options": [
            {
              "text": {
                "en": "It stays the same",
                "ar": "يبقى كما هو"
              },
              "correct": true
            },
            {
              "text": {
                "en": "It goes up",
                "ar": "يرتفع"
              }
            },
            {
              "text": {
                "en": "It disappears",
                "ar": "يختفي"
              }
            }
          ],
          "explain": {
            "en": "Fixed costs don't change with how much you sell.",
            "ar": "التكاليف الثابتة لا تتغير بحجم المبيعات."
          }
        }
      ]
    },
    {
      "id": "profit",
      "kind": "lesson",
      "icon": "💰",
      "title": {
        "en": "Profit or loss?",
        "ar": "ربح أم خسارة؟"
      },
      "steps": [
        {
          "type": "story",
          "art": "profit",
          "mascot": "thinking",
          "text": {
            "en": "PROFIT is what's left after paying ALL the costs: Profit = Revenue − Costs. If the costs are bigger than the revenue, that's a LOSS. Businesses keep a record called a P&L (profit and loss) to check.",
            "ar": "الربح هو ما يبقى بعد دفع كل التكاليف: الربح = الإيرادات − التكاليف. إذا زادت التكاليف على الإيرادات فهذه خسارة. تحتفظ المشاريع بسجل يسمى قائمة الأرباح والخسائر للتحقق."
          }
        },
        {
          "type": "number",
          "concept": "profit",
          "prompt": {
            "7-9": {
              "en": "You took in [[20]] and spent [[12]]. What's your profit?",
              "ar": "دخلك [[20]] وأنفقت [[12]]. ما ربحك؟"
            },
            "default": {
              "en": "Revenue [[200]]. Ingredients [[80]]. Stall rent [[50]]. What is the profit?",
              "ar": "الإيرادات [[200]] والمكونات [[80]] وإيجار الكشك [[50]]. ما الربح؟"
            }
          },
          "answer": {
            "7-9": 8,
            "default": 70
          },
          "explain": {
            "en": "Profit = revenue − all costs.",
            "ar": "الربح = الإيرادات − كل التكاليف."
          },
          "money": true,
          "hint": {
            "7-9": {
              "en": "20 − 12",
              "ar": "٢٠ − ١٢"
            },
            "default": {
              "en": "200 − 80 − 50",
              "ar": "٢٠٠ − ٨٠ − ٥٠"
            }
          }
        },
        {
          "type": "choice",
          "concept": "profit",
          "prompt": {
            "en": "Revenue [[100]], costs [[130]]. This business made…",
            "ar": "الإيرادات [[100]] والتكاليف [[130]]. هذا المشروع حقق…"
          },
          "options": [
            {
              "text": {
                "en": "A loss of [[30]]",
                "ar": "خسارة [[30]]"
              },
              "correct": true
            },
            {
              "text": {
                "en": "A profit of [[130]]",
                "ar": "ربح [[130]]"
              }
            },
            {
              "text": {
                "en": "A profit of [[30]]",
                "ar": "ربح [[30]]"
              }
            }
          ],
          "explain": {
            "en": "Costs were bigger than revenue: 100 − 130 = −30, a loss.",
            "ar": "التكاليف أكبر من الإيرادات: ١٠٠ − ١٣٠ = −٣٠، خسارة."
          }
        },
        {
          "type": "choice",
          "concept": "profit",
          "prompt": {
            "en": "Which is a good way to grow profit?",
            "ar": "ما الطريقة الجيدة لزيادة الربح؟"
          },
          "options": [
            {
              "text": {
                "en": "Sell more, or cut waste so costs go down",
                "ar": "بع أكثر أو قلّل الهدر لتنخفض التكاليف"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Give everything away free",
                "ar": "وزّع كل شيء مجاناً"
              }
            },
            {
              "text": {
                "en": "Buy more stalls you don't need",
                "ar": "اشترِ أكشاكاً لا تحتاجها"
              }
            }
          ],
          "explain": {
            "en": "Profit grows when revenue goes up or costs go down.",
            "ar": "الربح يزيد عندما ترتفع الإيرادات أو تنخفض التكاليف."
          }
        }
      ]
    },
    {
      "id": "pricing",
      "kind": "lesson",
      "icon": "🏷️",
      "title": {
        "en": "Picking the right price",
        "ar": "اختيار السعر المناسب"
      },
      "steps": [
        {
          "type": "story",
          "art": "price",
          "mascot": "thinking",
          "text": {
            "en": "Price too high? Few people buy. Price too low? Lots of people buy, but you might not cover your costs. The best price is somewhere in between!",
            "ar": "السعر مرتفع جداً؟ قليلون يشترون. منخفض جداً؟ كثيرون يشترون لكنك قد لا تغطي تكاليفك. أفضل سعر في مكان ما بينهما!"
          }
        },
        {
          "type": "sim",
          "sim": "stand",
          "params": {
            "unitCost": 2,
            "fixedCosts": 50
          },
          "text": {
            "en": "Run the stand: change the price and watch customers, revenue and profit.",
            "ar": "أدِر الكشك: غيّر السعر وراقب الزبائن والإيرادات والربح."
          }
        },
        {
          "type": "choice",
          "concept": "pricing",
          "prompt": {
            "en": "Each cup costs [[2]] to make. Is selling at [[1]] a good idea?",
            "ar": "كل كوب يكلف [[2]]. هل البيع بـ[[1]] فكرة جيدة؟"
          },
          "options": [
            {
              "text": {
                "en": "No, you lose [[1]] on every cup",
                "ar": "لا، تخسر [[1]] في كل كوب"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Yes, more customers is always better",
                "ar": "نعم، زبائن أكثر أفضل دائماً"
              }
            }
          ],
          "explain": {
            "en": "Below cost, every sale loses money, so the more you sell the more you lose!",
            "ar": "تحت التكلفة كل بيعة تخسر، فكلما بعت أكثر خسرت أكثر!"
          }
        },
        {
          "type": "number",
          "concept": "pricing",
          "prompt": {
            "en": "Each cup costs [[2]], the price is [[5]], and rent is [[60]]. How many cups must you sell to break even (cover the rent)?",
            "ar": "الكوب يكلف [[2]] والسعر [[5]] والإيجار [[60]]. كم كوباً يجب أن تبيع لتغطية الإيجار (نقطة التعادل)؟"
          },
          "answer": 20,
          "explain": {
            "en": "Each cup earns 5 − 2 = 3 towards the rent. 60 ÷ 3 = 20 cups. After that, it's profit!",
            "ar": "كل كوب يساهم بـ٥ − ٢ = ٣ في الإيجار. ٦٠ ÷ ٣ = ٢٠ كوباً. بعدها يبدأ الربح!"
          },
          "hint": {
            "en": "How much does each cup earn after its own cost?",
            "ar": "كم يكسب كل كوب بعد تكلفته؟"
          },
          "ages": [
            "10-12",
            "13-15"
          ],
          "unitText": {
            "en": "cups",
            "ar": "كوب"
          }
        }
      ]
    },
