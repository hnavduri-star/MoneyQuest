  "nodes": [
    {
      "id": "compare-prices",
      "kind": "lesson",
      "icon": "🔍",
      "title": {
        "en": "Compare before you buy",
        "ar": "قارن قبل أن تشتري"
      },
      "steps": [
        {
          "type": "story",
          "art": "price",
          "mascot": "excited",
          "text": {
            "en": "Welcome to {stop}! The same thing can cost different amounts in different shops or online. Smart shoppers COMPARE before they buy, and they always ask: do I need it, or just want it right now?",
            "ar": "أهلاً بك في {stop}! الشيء نفسه قد يختلف سعره من متجر لآخر أو عبر الإنترنت. المتسوّقون الأذكياء يقارنون قبل الشراء ويسألون دائماً: هل أحتاجه أم أرغب فيه الآن فقط؟"
          }
        },
        {
          "type": "estimate",
          "concept": "compare-prices",
          "prompt": {
            "en": "Quick guess! A basket has bread [[3]], milk [[6]], apples [[8]] and juice [[5]]. Slide to your estimate of the total.",
            "ar": "تخمين سريع! في السلة خبز [[3]] وحليب [[6]] وتفاح [[8]] وعصير [[5]]. حرّك المؤشر إلى تقديرك للمجموع."
          },
          "min": 5,
          "max": 40,
          "step": 1,
          "answer": 22,
          "tolerance": 2,
          "explain": {
            "en": "3 + 6 + 8 + 5 = 22. Estimating before the checkout helps you spot mistakes and stay on budget.",
            "ar": "٣ + ٦ + ٨ + ٥ = ٢٢. التقدير قبل الدفع يساعدك على اكتشاف الأخطاء والبقاء ضمن الميزانية."
          },
          "money": true
        },
        {
          "type": "number",
          "concept": "compare-prices",
          "prompt": {
            "en": "Shop A sells headphones for [[60]]. Shop B sells the same ones for [[45]]. How much do you save at Shop B?",
            "ar": "المتجر أ يبيع سماعات بـ[[60]] والمتجر ب يبيع نفسها بـ[[45]]. كم توفر في المتجر ب؟"
          },
          "answer": 15,
          "explain": {
            "en": "60 − 45 = 15.",
            "ar": "٦٠ − ٤٥ = ١٥."
          },
          "money": true
        }
      ]
    },
    {
      "id": "unit-price",
      "kind": "lesson",
      "icon": "⚖️",
      "title": {
        "en": "Unit prices: the real deal",
        "ar": "سعر الوحدة: الصفقة الحقيقية"
      },
      "steps": [
        {
          "type": "story",
          "art": "notes",
          "mascot": "thinking",
          "text": {
            "en": "Bigger packs aren't always cheaper! The UNIT PRICE tells you the cost of ONE item, or of 100 g, so you can compare different sizes fairly.",
            "ar": "العبوات الأكبر ليست دائماً أرخص! سعر الوحدة يخبرك بتكلفة قطعة واحدة أو ١٠٠ غرام، فتقارن بين الأحجام بعدل."
          }
        },
        {
          "type": "number",
          "concept": "unit-price",
          "prompt": {
            "en": "A pack of 4 juice boxes costs [[8]]. How much is ONE box?",
            "ar": "عبوة من ٤ علب عصير بـ[[8]]. كم سعر العلبة الواحدة؟"
          },
          "answer": 2,
          "explain": {
            "en": "8 ÷ 4 = 2 per box.",
            "ar": "٨ ÷ ٤ = ٢ للعلبة."
          },
          "money": true
        },
        {
          "type": "choice",
          "concept": "unit-price",
          "prompt": {
            "en": "Small: 6 pencils for [[6]]. Big: 10 pencils for [[12]]. Which is cheaper per pencil?",
            "ar": "صغيرة: ٦ أقلام بـ[[6]]. كبيرة: ١٠ أقلام بـ[[12]]. أيهما أرخص للقلم؟"
          },
          "options": [
            {
              "text": {
                "en": "The small pack ([[1]] each)",
                "ar": "العبوة الصغيرة ([[1]] للقلم)"
              },
              "correct": true
            },
            {
              "text": {
                "en": "The big pack ([[1.2]] each)",
                "ar": "العبوة الكبيرة ([[1.2]] للقلم)"
              }
            }
          ],
          "explain": {
            "en": "[[6]] ÷ 6 = [[1]] each, but [[12]] ÷ 10 = [[1.2]] each. This time, the small pack wins!",
            "ar": "[[6]] ÷ ٦ = [[1]] للقلم، لكن [[12]] ÷ ١٠ = [[1.2]] للقلم. هذه المرة العبوة الصغيرة تفوز!"
          }
        },
        {
          "type": "order",
          "concept": "unit-price",
          "prompt": {
            "en": "Order these from CHEAPEST to MOST EXPENSIVE per apple.",
            "ar": "رتّب هذه من الأرخص إلى الأغلى للتفاحة الواحدة."
          },
          "items": [
            {
              "emoji": "🍎",
              "text": {
                "en": "10 apples for [[5]] ([[0.5]] each)",
                "ar": "١٠ تفاحات بـ[[5]] ([[0.5]] للتفاحة)"
              }
            },
            {
              "emoji": "🍏",
              "text": {
                "en": "4 apples for [[3]] ([[0.75]] each)",
                "ar": "٤ تفاحات بـ[[3]] ([[0.75]] للتفاحة)"
              }
            },
            {
              "emoji": "🍎",
              "text": {
                "en": "1 apple for [[1]] ([[1]] each)",
                "ar": "تفاحة بـ[[1]] ([[1]] للتفاحة)"
              }
            }
          ],
          "explain": {
            "en": "Divide the price by the number of apples to compare fairly.",
            "ar": "اقسم السعر على عدد التفاحات لتقارن بعدل."
          },
          "ages": [
            "10-12",
            "13-15"
          ]
        }
      ]
    },
    {
      "id": "discounts",
      "kind": "lesson",
      "icon": "🏷️",
      "title": {
        "en": "Discounts and deals",
        "ar": "الخصومات والعروض"
      },
      "steps": [
        {
          "type": "story",
          "art": "price",
          "mascot": "happy",
          "text": {
            "en": "A DISCOUNT lowers the price, like '20% off'. 'Buy 2, get 1 free' can be great, but only if you really need 3! A deal on something you don't need is still money spent.",
            "ar": "الخصم يخفض السعر، مثل 'خصم ٢٠٪'. و'اشترِ ٢ واحصل على ١ مجاناً' قد يكون رائعاً، لكن فقط إن كنت تحتاج ٣ فعلاً! العرض على شيء لا تحتاجه يبقى مالاً منفقاً."
          }
        },
        {
          "type": "number",
          "concept": "discounts",
          "prompt": {
            "7-9": {
              "en": "A toy costs [[20]]. It's half price. What do you pay?",
              "ar": "لعبة بـ[[20]] بنصف السعر. كم تدفع؟"
            },
            "default": {
              "en": "Trainers cost [[50]] with 20% off. What do you pay?",
              "ar": "حذاء رياضي بـ[[50]] بخصم ٢٠٪. كم تدفع؟"
            }
          },
          "answer": {
            "7-9": 10,
            "default": 40
          },
          "explain": {
            "7-9": {
              "en": "Half of 20 is 10.",
              "ar": "نصف ٢٠ هو ١٠."
            },
            "default": {
              "en": "20% of 50 is 10, so you pay 50 − 10 = 40.",
              "ar": "٢٠٪ من ٥٠ هي ١٠، فتدفع ٥٠ − ١٠ = ٤٠."
            }
          },
          "money": true
        },
        {
          "type": "choice",
          "concept": "discounts",
          "prompt": {
            "en": "Biscuits are 'Buy 2, get 1 free' at [[3]] each. You only need 1 packet. Good deal for you?",
            "ar": "البسكويت 'اشترِ ٢ واحصل على ١ مجاناً' بسعر [[3]] للعلبة. تحتاج علبة واحدة فقط. هل هو عرض جيد لك؟"
          },
          "options": [
            {
              "text": {
                "en": "No: you'd spend [[6]] instead of [[3]]",
                "ar": "لا: ستنفق [[6]] بدلاً من [[3]]"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Yes, free stuff!",
                "ar": "نعم، أشياء مجانية!"
              }
            }
          ],
          "explain": {
            "en": "A deal only saves money if you'd use everything you buy.",
            "ar": "العرض يوفر المال فقط إذا كنت ستستخدم كل ما تشتريه."
          }
        }
      ]
    },
    {
      "id": "marketing",
      "kind": "lesson",
      "icon": "📣",
      "title": {
        "en": "Marketing tricks and peer pressure",
        "ar": "حيل التسويق وضغط الأصدقاء"
      },
      "steps": [
        {
          "type": "story",
          "art": "thinking",
          "mascot": "wink",
          "text": {
            "en": "Shops and apps use tricks: prices ending in .99 to look smaller, sweets near the checkout, 'only 2 left!', and influencers showing off products. Friends can make us want things too. Knowing the tricks helps you choose for yourself.",
            "ar": "تستخدم المتاجر والتطبيقات حيلاً: أسعار تنتهي بـ.٩٩ لتبدو أصغر، وحلويات قرب الصندوق، و'بقي ٢ فقط!'، ومؤثرون يستعرضون المنتجات. والأصدقاء قد يجعلوننا نرغب بالأشياء أيضاً. معرفة الحيل تساعدك على الاختيار بنفسك."
          }
        },
        {
          "type": "sort",
          "concept": "marketing",
          "prompt": {
            "en": "Marketing trick or useful info?",
            "ar": "حيلة تسويقية أم معلومة مفيدة؟"
          },
          "bins": [
            {
              "id": "trick",
              "emoji": "🎩",
              "label": {
                "en": "Marketing trick",
                "ar": "حيلة تسويقية"
              }
            },
            {
              "id": "info",
              "emoji": "ℹ️",
              "label": {
                "en": "Useful info",
                "ar": "معلومة مفيدة"
              }
            }
          ],
          "items": [
            {
              "emoji": "⏳",
              "text": {
                "en": "'Only 2 left! Buy now!'",
                "ar": "'بقي ٢ فقط! اشترِ الآن!'"
              },
              "bin": "trick"
            },
            {
              "emoji": "🍬",
              "text": {
                "en": "Sweets placed at the checkout",
                "ar": "حلويات عند صندوق الدفع"
              },
              "bin": "trick"
            },
            {
              "emoji": "💯",
              "text": {
                "en": "Price [[9.99]] instead of [[10]]",
                "ar": "سعر [[9.99]] بدلاً من [[10]]"
              },
              "bin": "trick"
            },
            {
              "emoji": "⚖️",
              "text": {
                "en": "Price per 100 g on the label",
                "ar": "السعر لكل ١٠٠ غرام على الملصق"
              },
              "bin": "info"
            },
            {
              "emoji": "📝",
              "text": {
                "en": "List of ingredients",
                "ar": "قائمة المكونات"
              },
              "bin": "info"
            },
            {
              "emoji": "🤳",
              "text": {
                "en": "An influencer paid to show a toy",
                "ar": "مؤثر يُدفع له لعرض لعبة"
              },
              "bin": "trick"
            }
          ]
        },
        {
          "type": "scenario",
          "key": "peer-pressure",
          "prompt": {
            "en": "All your friends are buying expensive limited-edition trainers for [[120]]. You have [[60]] saved for a bike. What do you do?",
            "ar": "كل أصدقائك يشترون حذاء رياضياً محدود الإصدار بـ[[120]]. لديك [[60]] مدخرة لدراجة. ماذا تفعل؟"
          },
          "options": [
            {
              "emoji": "🚲",
              "text": {
                "en": "Keep saving for the bike",
                "ar": "أواصل الادخار للدراجة"
              },
              "outcome": {
                "en": "You stuck to your own goal. In a few weeks you'll ride the bike, and the trainer craze will probably be over.",
                "ar": "التزمت بهدفك. خلال أسابيع ستركب الدراجة، وموضة الحذاء ستنتهي غالباً."
              },
              "wise": true
            },
            {
              "emoji": "👟",
              "text": {
                "en": "Ask to borrow money to buy the trainers",
                "ar": "أطلب اقتراض المال لشراء الحذاء"
              },
              "outcome": {
                "en": "You'd owe [[60]] and lose your bike savings. Fitting in feels good for a day; debt lasts longer.",
                "ar": "ستصبح مديناً بـ[[60]] وتخسر مدخرات الدراجة. الانسجام مع الأصدقاء ممتع ليوم؛ الدين يدوم أطول."
              }
            },
            {
              "emoji": "💬",
              "text": {
                "en": "Tell friends you're saving for something you want more",
                "ar": "أخبر أصدقائي أنني أدخر لشيء أريده أكثر"
              },
              "outcome": {
                "en": "Brave and honest! Good friends respect your goals, and some may even start saving too.",
                "ar": "شجاعة وصدق! الأصدقاء الجيدون يحترمون أهدافك، وقد يبدأ بعضهم بالادخار أيضاً."
              },
              "wise": true
            }
          ]
        },
        {
          "type": "choice",
          "concept": "peer-pressure",
          "prompt": {
            "en": "What helps most when you really want something because everyone has it?",
            "ar": "ما الأكثر فائدة عندما تريد شيئاً لأن الجميع يملكه؟"
          },
          "options": [
            {
              "text": {
                "en": "Wait a few days and check if you still want it",
                "ar": "انتظر بضعة أيام وتحقق إن كنت ما زلت تريده"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Buy it immediately",
                "ar": "اشترِه فوراً"
              }
            }
          ],
          "explain": {
            "en": "A short wait lets the 'everyone has it' feeling fade so you can decide calmly.",
            "ar": "الانتظار القصير يُخفت شعور 'الجميع يملكه' فتقرر بهدوء."
          }
        }
      ]
    },
