    {
      "id": "quiz",
      "kind": "quiz",
      "icon": "📝",
      "title": {
        "en": "Smart Shopper quiz",
        "ar": "اختبار المتسوّق الذكي"
      },
      "steps": [
        {
          "type": "choice",
          "concept": "compare-prices",
          "prompt": {
            "en": "Before a big purchase it's smart to…",
            "ar": "قبل شراء كبير من الذكاء أن…"
          },
          "options": [
            {
              "text": {
                "en": "Compare prices",
                "ar": "تقارن الأسعار"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Buy at the first shop",
                "ar": "تشتري من أول متجر"
              }
            }
          ],
          "explain": {
            "en": "Comparing can save a lot on the same item.",
            "ar": "المقارنة قد توفر الكثير على الشيء نفسه."
          }
        },
        {
          "type": "number",
          "concept": "unit-price",
          "prompt": {
            "en": "6 eggs for [[3]]. Price of one egg?",
            "ar": "٦ بيضات بـ[[3]]. سعر البيضة الواحدة؟"
          },
          "answer": 0.5,
          "explain": {
            "en": "3 ÷ 6 = 0.50.",
            "ar": "٣ ÷ ٦ = ٠٫٥٠."
          },
          "money": true
        },
        {
          "type": "number",
          "concept": "discounts",
          "prompt": {
            "en": "A game costs [[40]] with 25% off. What do you pay?",
            "ar": "لعبة بـ[[40]] بخصم ٢٥٪. كم تدفع؟"
          },
          "answer": 30,
          "explain": {
            "en": "25% of 40 = 10, so 40 − 10 = 30.",
            "ar": "٢٥٪ من ٤٠ = ١٠، إذن ٤٠ − ١٠ = ٣٠."
          },
          "money": true
        },
        {
          "type": "choice",
          "concept": "marketing",
          "prompt": {
            "en": "'Only 2 left!' is often used to…",
            "ar": "'بقي ٢ فقط!' تُستخدم غالباً لـ…"
          },
