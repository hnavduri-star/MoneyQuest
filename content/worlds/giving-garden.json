  "nodes": [
    {
      "id": "why-give",
      "kind": "lesson",
      "icon": "💝",
      "title": {
        "en": "Why do people give?",
        "ar": "لماذا يعطي الناس؟"
      },
      "steps": [
        {
          "type": "story",
          "art": "partners",
          "mascot": "happy",
          "text": {
            "en": "Welcome to the Giving Garden in {city}! Many people share part of their money, time or skills to help others: to feed families, support schools, protect animals or help after disasters. Giving makes communities stronger, and it feels good too.",
            "ar": "أهلاً بك في حديقة العطاء في {city}! كثير من الناس يشاركون جزءاً من مالهم أو وقتهم أو مهاراتهم لمساعدة الآخرين: لإطعام العائلات ودعم المدارس وحماية الحيوانات والمساعدة بعد الكوارث. العطاء يقوّي المجتمعات ويُشعرنا بالسعادة أيضاً."
          }
        },
        {
          "type": "sort",
          "concept": "why-give",
          "prompt": {
            "en": "Giving money or giving time?",
            "ar": "عطاء بالمال أم بالوقت؟"
          },
          "bins": [
            {
              "id": "money",
              "emoji": "🪙",
              "label": {
                "en": "Giving money",
                "ar": "عطاء بالمال"
              }
            },
            {
              "id": "time",
              "emoji": "⏰",
              "label": {
                "en": "Giving time",
                "ar": "عطاء بالوقت"
              }
            }
          ],
          "items": [
            {
              "emoji": "🥫",
              "text": {
                "en": "Donating to a food bank",
                "ar": "التبرع لبنك الطعام"
              },
              "bin": "money"
            },
            {
              "emoji": "🧹",
              "text": {
                "en": "Helping clean a beach",
                "ar": "المساعدة في تنظيف شاطئ"
              },
              "bin": "time"
            },
            {
              "emoji": "📚",
              "text": {
                "en": "Reading to younger children",
                "ar": "القراءة للأطفال الأصغر"
              },
              "bin": "time"
            },
            {
              "emoji": "🏥",
              "text": {
                "en": "Giving to a hospital appeal",
                "ar": "التبرع لحملة مستشفى"
              },
              "bin": "money"
            },
            {
              "emoji": "🐾",
              "text": {
                "en": "Volunteering at an animal shelter",
                "ar": "التطوع في ملجأ حيوانات"
              },
              "bin": "time"
            },
            {
              "emoji": "🌳",
              "text": {
                "en": "Paying for a tree to be planted",
                "ar": "دفع ثمن زراعة شجرة"
              },
              "bin": "money"
            }
          ]
        },
        {
          "type": "choice",
          "concept": "why-give",
          "prompt": {
            "en": "Which is a way to give without money?",
            "ar": "أيّها طريقة للعطاء دون مال؟"
          },
          "options": [
            {
              "text": {
                "en": "Volunteering your time",
                "ar": "التطوع بوقتك"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Buying a new game",
                "ar": "شراء لعبة جديدة"
              }
            }
          ],
          "explain": {
            "en": "Time and kindness are gifts too.",
            "ar": "الوقت واللطف عطاء أيضاً."
          }
        }
      ]
    },
    {
      "id": "zakat-sadaqah",
      "kind": "lesson",
      "icon": "🤲",
      "title": {
        "en": "Zakat, sadaqah and giving traditions",
        "ar": "الزكاة والصدقة وتقاليد العطاء"
      },
      "steps": [
        {
          "type": "story",
          "art": "jar",
          "mascot": "thinking",
          "text": {
            "en": "Many faiths and cultures have giving traditions. In Islam, ZAKAT is a required yearly gift of 2.5% of savings above a minimum (nisab) for those who are eligible, and SADAQAH is any voluntary act of charity, even a smile. Other traditions include tithing, daan and dasvandh.",
            "ar": "لكثير من الأديان والثقافات تقاليد للعطاء. في الإسلام الزكاة فريضة سنوية بنسبة ٢٫٥٪ من المدخرات فوق حد أدنى (النصاب) لمن تجب عليهم، والصدقة أي عمل خيري تطوعي ولو ابتسامة. ومن التقاليد الأخرى العُشر والدان والدسوند."
          }
        },
        {
          "type": "number",
          "concept": "zakat-sadaqah",
          "prompt": {
            "en": "Savings above the nisab are [[8000]], kept for a full year. Zakat is 2.5%. How much is it?",
            "ar": "المدخرات فوق النصاب [[8000]] لمدة عام كامل. الزكاة ٢٫٥٪. كم مقدارها؟"
          },
          "answer": 200,
          "explain": {
            "en": "2.5% of 8000 = 8000 × 2.5 ÷ 100 = 200.",
            "ar": "٢٫٥٪ من ٨٠٠٠ = ٨٠٠٠ × ٢٫٥ ÷ ١٠٠ = ٢٠٠."
          },
          "money": true,
          "ages": [
            "10-12",
            "13-15"
          ]
        },
        {
          "type": "choice",
          "concept": "zakat-sadaqah",
          "prompt": {
            "en": "Sadaqah means…",
            "ar": "الصدقة تعني…"
          },
          "options": [
            {
              "text": {
                "en": "Voluntary charity, big or small",
                "ar": "الإحسان التطوعي كبيراً أو صغيراً"
              },
              "correct": true
            },
            {
              "text": {
                "en": "A shop discount",
                "ar": "خصم في المتجر"
              }
            }
          ],
          "explain": {
            "en": "Sadaqah is any kind act of giving, whenever you choose.",
            "ar": "الصدقة أي عمل عطاء طيب متى اخترت."
          }
        }
      ]
    },
    {
      "id": "give-jar",
      "kind": "lesson",
      "icon": "🫙",
      "title": {
        "en": "Your Give jar",
        "ar": "برطمان العطاء الخاص بك"
      },
      "steps": [
        {
          "type": "story",
          "art": "jar",
          "mascot": "happy",
          "text": {
            "en": "A simple habit: whenever money comes in, split it into SAVE, SPEND and GIVE jars. Even a small Give jar adds up over a year.",
            "ar": "عادة بسيطة: كلما دخل المال قسّمه بين برطمانات الادخار والإنفاق والعطاء. حتى برطمان عطاء صغير يتراكم خلال سنة."
          }
        },
        {
          "type": "sim",
          "sim": "jars",
          "params": {
            "amount": 20
          },
          "text": {
            "en": "Split [[20]] of pocket money between your jars.",
            "ar": "قسّم [[20]] من المصروف بين برطماناتك."
          }
        },
        {
          "type": "number",
          "concept": "give-jar",
          "prompt": {
            "en": "You put [[2]] in your Give jar every week. How much after 10 weeks?",
            "ar": "تضع [[2]] في برطمان العطاء كل أسبوع. كم بعد ١٠ أسابيع؟"
          },
          "answer": 20,
          "explain": {
            "en": "2 × 10 = 20. Small gifts add up!",
            "ar": "٢ × ١٠ = ٢٠. العطاء الصغير يتراكم!"
          },
          "money": true
        }
      ]
    },
    {
      "id": "impact",
      "kind": "lesson",
      "icon": "🌱",
      "title": {
        "en": "Making a real impact",
        "ar": "صنع أثر حقيقي"
      },
      "steps": [
        {
          "type": "story",
          "art": "grow",
          "mascot": "thinking",
          "text": {
            "en": "Good givers check that a charity is real and registered, and they think about IMPACT: what will the money actually do? A little research helps your gift do the most good.",
            "ar": "المعطون الجيدون يتأكدون أن الجمعية الخيرية حقيقية ومسجّلة، ويفكرون في الأثر: ماذا سيفعل المال فعلاً؟ قليل من البحث يجعل عطاءك أكثر نفعاً."
          }
        },
        {
          "type": "estimate",
          "concept": "impact",
          "prompt": {
            "en": "A food charity says [[5]] provides one meal. Slide to how many meals [[50]] provides.",
            "ar": "جمعية طعام تقول إن [[5]] توفر وجبة. حرّك المؤشر إلى عدد الوجبات التي توفرها [[50]]."
          },
          "min": 1,
          "max": 20,
          "step": 1,
          "answer": 10,
          "tolerance": 0,
          "explain": {
            "en": "50 ÷ 5 = 10 meals. Thinking in meals, trees or books shows the real difference your gift makes.",
            "ar": "٥٠ ÷ ٥ = ١٠ وجبات. التفكير بالوجبات أو الأشجار أو الكتب يُظهر الفرق الحقيقي لعطائك."
          },
          "unitText": {
            "en": "meals",
            "ar": "وجبات"
          }
        },
        {
          "type": "choice",
          "concept": "impact",
          "prompt": {
            "en": "A stranger online asks for donations with no name or registration. You…",
            "ar": "غريب على الإنترنت يطلب تبرعات بلا اسم أو تسجيل. أنت…"
          },
          "options": [
            {
              "text": {
                "en": "Ask a grown-up to check it's a real, registered charity",
                "ar": "أطلب من أحد الكبار التأكد أنها جمعية حقيقية ومسجّلة"
              },
              "correct": true
            },
            {
              "text": {
                "en": "Send money right away",
                "ar": "أرسل المال فوراً"
              }
            }
          ],
          "explain": {
            "en": "Scammers sometimes pretend to be charities. Check first, then give with confidence.",
            "ar": "المحتالون يتظاهرون أحياناً بأنهم جمعيات خيرية. تحقق أولاً ثم أعطِ بثقة."
          }
        },
        {
          "type": "scenario",
          "key": "giving-choice",
          "prompt": {
            "en": "Your class raised [[100]]. What should it go to?",
            "ar": "جمع صفّك [[100]]. لمن تذهب؟"
          },
          "options": [
            {
              "emoji": "🥫",
              "text": {
                "en": "Meals for families nearby",
                "ar": "وجبات لعائلات قريبة"
              },
              "outcome": {
                "en": "Twenty families got a warm meal this week. Local giving lets you see the difference.",
                "ar": "حصلت عشرون عائلة على وجبة دافئة هذا الأسبوع. العطاء المحلي يُريك الفرق."
              },
              "wise": true
            },
            {
              "emoji": "🌳",
              "text": {
                "en": "Planting trees",
                "ar": "زراعة الأشجار"
              },
              "outcome": {
                "en": "Your class planted a small grove that will clean the air for years.",
                "ar": "زرع صفّك بستاناً صغيراً سينقّي الهواء لسنوات."
              },
              "wise": true
            },
            {
              "emoji": "📚",
              "text": {
                "en": "Books for a school library",
                "ar": "كتب لمكتبة مدرسة"
              },
              "outcome": {
                "en": "A whole shelf of new books for children who had very few. Reading changes lives!",
                "ar": "رف كامل من الكتب الجديدة لأطفال كانت كتبهم قليلة جداً. القراءة تغيّر الحياة!"
              },
              "wise": true
            }
          ]
        }
      ]
    },
