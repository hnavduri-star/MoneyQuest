    {
      "id": "boss",
      "kind": "boss",
      "icon": "🦝",
      "title": {
        "en": "Boss: Greedy Gus",
        "ar": "الزعيم: غاس الطمّاع"
      },
      "boss": {
        "id": "greedy-gus",
        "name": {
          "en": "Greedy Gus",
          "ar": "غاس الطمّاع"
        },
        "color": "#009E73",
        "intro": {
          "en": "Mine, mine, MINE! I'm Greedy Gus and I never share anything. Can you convince me that giving is worth it?",
          "ar": "لي، لي، لي! أنا غاس الطمّاع ولا أشارك شيئاً أبداً. هل تقنعني أن العطاء يستحق؟"
        },
        "taunt": {
          "en": "Hmph! Not convinced yet. Try again!",
          "ar": "همف! لم أقتنع بعد. حاول مجدداً!"
        },
        "defeat": {
          "en": "Oh... maybe sharing IS nice. Here, have a cookie!",
          "ar": "أوه... ربما المشاركة لطيفة فعلاً. خذ، تفضل كعكة!"
        }
      },
      "steps": [
        {
          "type": "choice",
          "concept": "why-give",
          "prompt": {
            "en": "Gus: 'Giving only helps other people, not me!' True?",
            "ar": "غاس: 'العطاء يساعد الآخرين فقط، لا أنا!' صحيح؟"
          },
          "options": [
            {
              "text": {
                "en": "Giving strengthens communities we all live in, and feels good",
