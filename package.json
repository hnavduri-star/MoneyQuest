{
  "name": "moneyquest",
  "private": true,
  "version": "0.1.0",
  "description": "MoneyQuest: a child-safe money-learning town game (PWA).",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run content:check && npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "content:check": "node scripts/check-content.mjs",
    "build:page": "npm run build:page -w client",
    "review:export": "node scripts/review-export.mjs",
    "review:import": "node scripts/review-import.mjs"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
